{
  "name": "W10 · Vigia de falhas (fluxo de erro global)",
  "nodes": [
    {
      "id": "w10-erro",
      "name": "Quando um fluxo falhar",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "w10-tem-slack",
      "name": "Slack configurado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "notes": "Sem SLACK_WEBHOOK_URL, a falha fica registrada nas execuções do n8n (este fluxo guarda todas) em vez de o próprio vigia falhar.",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-slack",
              "leftValue": "={{ ($env.SLACK_WEBHOOK_URL || '').startsWith('https://') }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "w10-slack",
      "name": "Avisar operação (Slack)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `:rotating_light: Falha no fluxo *${$json.workflow.name}*\\nEtapa: ${$json.execution.lastNodeExecuted || '—'}\\nErro: ${($json.execution.error && $json.execution.error.message) || 'sem mensagem'}\\nExecução: ${$json.execution.url || '—'}` }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Quando um fluxo falhar": {
      "main": [
        [
          {
            "node": "Slack configurado?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Slack configurado?": {
      "main": [
        [
          {
            "node": "Avisar operação (Slack)",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  },
  "pinData": {}
}
