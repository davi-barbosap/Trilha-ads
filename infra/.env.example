# Copie para infra/.env (nunca versionar). Gere segredos longos e aleatórios.
N8N_VERSION=            # versão 2.x fixa e testada — nunca "latest"
N8N_DOMINIO=automacao.suaagencia.com.br
N8N_ENCRYPTION_KEY=     # guarde também fora do servidor: sem ela, as credenciais do n8n não voltam do backup
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
TRILHA_API_TOKEN=
TRILHA_SIMULAR=1
TRILHA_CLIENTES_DIR=/srv/Trilha-clientes/ads
TRILHA_RESPONSAVEL_TECNICO=
SLACK_WEBHOOK_URL=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
META_TEST_EVENT_CODE=
