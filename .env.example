# Uso local (CLI e testes). No servidor: infra/.env.example e infra/kommo.env.example.
# Lido automaticamente por `python -m trilha` (pasta atual ou TRILHA_ENV_FILE) e pelo ambiente local em Docker:
#   docker compose -f infra/local/docker-compose.yml --env-file .env up -d --build
# Guia: docs/operacao/ambiente-local.md

# Ambiente local (infra/local/docker-compose.yml)
N8N_VERSION=2.42.3                  # mesma versão fixa da produção; nunca "latest"
N8N_DADOS=                          # pasta de dados do n8n no seu computador (ex.: /Users/voce/.n8n)
N8N_URL_PUBLICA=                    # endereço do túnel, com / no fim; vazio = localhost
N8N_API_URL=http://localhost:5678   # infra/n8n_importar.py (produção: https://<domínio>)
N8N_API_KEY=                        # n8n → Settings → n8n API

# Kommo — um par por cliente (sufixo = cliente.id em maiúsculas, "-" vira "_")
KOMMO_TOKEN__EXEMPLO=
KOMMO_WEBHOOK_TOKEN__EXEMPLO=

# Meta — API de Conversões
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
META_TEST_EVENT_CODE=

# Google — conversões offline pela Data Manager API (OAuth com escopo da Data Manager API)
GOOGLE_DATA_MANAGER_VALIDAR=1    # 1 = validateOnly (nada é gravado); 0 só depois do primeiro teste aprovado
# Google Ads API (coleta de métricas e alterações aprovadas)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# ClickUp (mesmos nomes de variável das ferramentas da equipe: mesmo workspace)
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_CLIENTS_SPACE_ID=
CLICKUP_CLIENT_MODE=folder          # folder = uma pasta por cliente · list = uma lista por cliente
CLICKUP_DEFAULT_LIST_NAME=Operação
CLICKUP_WEBHOOK_SECRET=

# Slack (urgências, freio, falhas, leitura diária — nunca para o cliente)
SLACK_WEBHOOK_URL=

# Trilha
TRILHA_API_TOKEN=
TRILHA_API_URL=http://localhost:8080
TRILHA_RESPONSAVEL_TECNICO=         # quem recebe os alertas técnicos (credencial, coleta, acesso a conta)
TRILHA_SIMULAR=1                 # 0 só depois do teste com META_TEST_EVENT_CODE
TRILHA_CLIENTES_DIR=../Trilha-clientes/ads
TRILHA_LOG_DIR=logs
